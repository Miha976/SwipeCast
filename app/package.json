{
  "name": "@swipecast/app",
  "productName": "SwipeCast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SwipeCast — envoyer une vidéo en cours vers l'autre appareil sans perdre la progression",
  "author": "Chanlang Mihalick Abou",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "electron:dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:start": "npm run build && electron .",
    "electron:dist": "npm run build && electron-builder --win nsis",
    "android": "npm run build && cap sync android && cap open android",
    "android:sync": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capgo/capacitor-inappbrowser": "^8.27.9",
    "@swipecast/server": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.6",
    "sass": "^1.108.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^8.3.8",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "dev.miha976.swipecast",
    "productName": "SwipeCast",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "shared/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
